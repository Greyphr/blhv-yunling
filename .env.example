DISCORD_TOKEN=your_discord_bot_token_here
TWITCH_CLIENT_ID=your_twitch_client_id_here
TWITCH_CLIENT_SECRET=your_twitch_client_secret_here

# Optional (music): cookies.txt path if YouTube blocks you; 0 skips the yt-dlp auto-update
# COOKIES_FILE=cookies.txt
# AUTO_UPDATE_YTDLP=0

# Optional: where data.json and logs/ are stored (default: next to bot.py).
# Docker sets this to /data for you.
# DATA_DIR=/data
# Optional: 1 = also print logs to the console (Docker sets this for you)
# LOG_TO_CONSOLE=1
